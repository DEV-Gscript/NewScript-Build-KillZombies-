local function computeAutoScale()
    local cam = workspace.CurrentCamera
    if not cam then return 0.99 end
    local vp = cam.ViewportSize
    if vp.X <= 0 or vp.Y <= 0 then return 0.99 end
    local marginW = IS_MOBILE and 0.94 or 0.90
    local marginH = IS_MOBILE and 0.74 or 0.85
    local scaleW = (vp.X * marginW) / BASE_W
    local scaleH = (vp.Y * marginH) / BASE_H
    return math.clamp(math.min(scaleW, scaleH, 0.99), 0.45, 0.99)
end

local function updateUIScale()
    local scale
    if S.uiScaleOverride and S.uiScaleOverride > 0 then
        scale = math.clamp(S.uiScaleOverride / 100, 0.3, 2.0)
    else
        scale = computeAutoScale()
    end
    if uiScale then pcall(function() uiScale.Scale = scale end) end
end

