local function registerItem(name, rarity, meta)
    if not name or name == "" or name == "???" then return end
    local key = string.lower(tostring(name))
    if not discoveredItems[key] then
        discoveredItems[key] = {
            name = tostring(name),
            rarity = rarity or "Unknown",
            category = meta and meta.category or nil,
            chance = meta and meta.chance or nil,
            cost = meta and meta.cost or nil,
            stats = meta and meta.stats or nil,
            modelKey = meta and meta.modelKey or nil,
        }
        itemListDirty = true
    else
        local e = discoveredItems[key]
        if rarity and rarity ~= "Unknown" and e.rarity == "Unknown" then
            e.rarity = rarity
            itemListDirty = true
        end
        if meta then
            if meta.category then e.category = meta.category end
            if meta.chance then e.chance = meta.chance end
            if meta.cost then e.cost = meta.cost end
            if meta.stats then e.stats = meta.stats end
            if meta.modelKey then e.modelKey = meta.modelKey end
        end
    end
end

