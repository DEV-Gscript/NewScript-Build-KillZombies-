local function refreshManualBlacklist()
    selectedBlacklistItems = {}
    local text = tostring(S.blacklistText or "")
    local count = 0

    for keyword in string.gmatch(text, "[^,]+") do
        keyword = string.lower(string.gsub(keyword, "^%s*(.-)%s*$", "%1"))
        if keyword ~= "" then
            if not selectedBlacklistItems[keyword] then
                selectedBlacklistItems[keyword] = true
                count = count + 1
            end
        end
    end

    blacklistStatus.Text = string.format("Blacklist: %d keyword%s", count, count == 1 and "" or "s")
end

