                                        if rName then
                                            registerItem(itemName, rName, entry and {
                                                category = entry.category,
                                                chance = entry.chance,
                                                cost = entry.cost,
                                                stats = entry.stats,
                                            } or nil)
                                        end

                                        -- 4) blacklist check: exact or substring, both lowercase
                                        local isBlacklisted = false
                                        if S.useBlacklist then
                                            local itemLow = string.lower(itemName)
                                            for blKey, active in pairs(selectedBlacklistItems) do
                                                if active then
                                                    local kw = tostring(blKey)
                                                    if itemLow == kw or string.find(itemLow, kw, 1, true) then
                                                        isBlacklisted = true
                                                        break
                                                    end
                                                end
                                            end
                                        end

                                        -- 5) buy decision
                                        local shouldBuy
                                        if isBlacklisted then
                                            shouldBuy = false
                                        elseif S.blacklistOnly then
                                            shouldBuy = true
                                        else
                                            -- rarity gate: unknown = allow (name is trustworthy)
                                            local rarityOk = (not rIdx) or (rIdx >= S.minRarityIdx)
                                            shouldBuy = rarityOk
                                        end

                                        -- 6) log skip reason
                                        if not shouldBuy and S.rollBuyOn then
                                            local reason = isBlacklisted and "BLACKLISTED"
                                                        or (rIdx and "LOW RARITY")
                                                        or "NO DATA"
                                            addLog(string.format("SKIP [%s]: %s (%s)", reason, itemName, rName or "?"), "SKIP")
                                        end
                                        -- ================================================

                                        if shouldBuy then
                                            _G.rollPauseUntil = tick() + S.rollBuyWait
                                            local hrp = lp and lp.Character and lp.Character:FindFirstChild("HumanoidRootPart")
                                            local oldCFrame = hrp and hrp.CFrame
                                            for _ = 1, 3 do
                                                firePromptSafe(buyPrompt)
                                                task.wait(0.2)
                                            end
                                            if hrp and oldCFrame then
                                                task.wait(0.2)
                                                hrp.CFrame = oldCFrame
                                            end
                                            S.buyN = S.buyN + 1
                                            local logMsg = itemName .. " (" .. (rName or "Unknown") .. ")"
                                            addLog(logMsg, "BOUGHT")
                                            notify("BOUGHT: " .. logMsg, false)
                                        else
                                            notify("SKIP: " .. itemName .. " (" .. (rName or "?") .. ")", true)
                                        end
                                    end
                                else
                                    lastBuyStandState[standName] = nil
                                end
                            else
                                lastBuyStandState[standName] = nil
                            end
                        end
                    end
                end
            end)
        end
    end
end)

