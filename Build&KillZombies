local function hollowGetZoneFromCar(car)
    local hr = workspace:FindFirstChild("HollowRuns")
    if not hr or not car or not car.PrimaryPart then return nil end
    local carPos = car.PrimaryPart.Position
    local best, bestD = nil, math.huge
    for _, zone in ipairs(hr:GetChildren()) do
        if zone.Name:match("^Zone_%d+$") then
            local b = zone:FindFirstChild("Bounds")
            if b and b:IsA("BasePart") then
                local d = (carPos - b.Position).Magnitude
                if d < bestD then bestD = d; best = zone end
            end
        end
    end
    return best
end

local function hollowZoneNearPlayer()
    local hr = workspace:FindFirstChild("HollowRuns")
    if not hr then return nil end
    local char = lp and lp.Character
    local hrp = char and char:FindFirstChild("HumanoidRootPart")
    if not hrp then return nil end
    local pos = hrp.Position
    local best, bestD = nil, math.huge
    for _, zone in ipairs(hr:GetChildren()) do
        if zone.Name:match("^Zone_%d+$") then
            local b = zone:FindFirstChild("Bounds")
            if b and b:IsA("BasePart") then
                local d = (pos - b.Position).Magnitude
                if d < bestD then bestD = d; best = zone end
            end
        end
    end
    return best
end

local function hollowGetNextZone(cur)
    local hr = workspace:FindFirstChild("HollowRuns")
    if not hr or not cur then return nil end
    local n = tonumber(cur.Name:match("%d+"))
    if not n then return nil end
    local nz = hr:FindFirstChild("Zone_" .. (n + 1))
    if nz then return nz end
    local best, bestN = nil, math.huge
    for _, z in ipairs(hr:GetChildren()) do
        local num = tonumber(z.Name:match("^Zone_(%d+)$"))
        if num and num > n and num < bestN then bestN = num; best = z end
    end
    return best
end

local function hollowIsGateOpen(zone)
    local gate = zone and zone:FindFirstChild("Gate")
    if not gate then return false end
    local r = gate:FindFirstChild("Right Gate Leaf")
    local l = gate:FindFirstChild("Left Gate Leaf")
    if r and l then return (not r.CanCollide) and (not l.CanCollide) end
    return false
end

local function hollowGetFloorY(zone)
    if not zone then return nil end
    local env = zone:FindFirstChild("01 - Environment")
    local searchRoot = env or zone
    local bestY = nil
    for _, desc in ipairs(searchRoot:GetDescendants()) do
        if desc:IsA("BasePart") then
            local lower = string.lower(desc.Name)
            if string.find(lower, "foundation", 1, true) then
                if not bestY or desc.Position.Y > bestY then bestY = desc.Position.Y end
            end
        end
    end
    return bestY
end

local HOLLOW_BOSS_IGNORE = {"deathburst", "dungeondeath", "burst", "effect", "vfx"}
local function hollowIsBossIgnored(name)
    local lower = string.lower(name)
    for _, kw in ipairs(HOLLOW_BOSS_IGNORE) do
        if string.find(lower, kw, 1, true) then return true end
    end
    return false
end

local function hollowGetBoss(carPos)
    local playerChars = {}
    for _, pl in ipairs(Players:GetPlayers()) do
        if pl.Character then playerChars[pl.Character] = true end
    end
    local best, bestRoot, bestD = nil, nil, math.huge
    for _, folderName in ipairs({"ClientBosses", "ClientZombies"}) do
        local folder = workspace:FindFirstChild(folderName)
        if folder then
            for _, child in ipairs(folder:GetChildren()) do
                if child:IsA("Model") and not playerChars[child] and not hollowIsBossIgnored(child.Name) then
                    local root = child:FindFirstChild("HumanoidRootPart") or child:FindFirstChild("Root") or child.PrimaryPart
                    if root then
                        local hum = child:FindFirstChildOfClass("Humanoid")
                        local alive = not (hum and hum.Health <= 0)
                        if alive then
                            local d = (carPos - root.Position).Magnitude
                            if d < bestD then bestD = d; best = child; bestRoot = root end
                        end
                    end
                end
            end
        end
    end
    return best, bestRoot
end

local function hollowGetPortal()
    local hp = workspace:FindFirstChild("HollowPortals")
    if not hp then return nil end
    local p = hp:FindFirstChild("Portal")
    if p and p:IsA("Model") then return p end
    return nil
end

local function hollowGetTrigger()
    local portal = hollowGetPortal()
    if not portal then return nil end
    local trig = portal:FindFirstChild("Trigger")
    if trig and trig:IsA("BasePart") then return trig end
    return nil
end

local function hollowGetPane()
    local portal = hollowGetPortal()
    if not portal then return nil end
    local pane = portal:FindFirstChild("Pane")
    if pane and pane:IsA("BasePart") then return pane end
    return nil
end

local function hollowPortalAvailable()
    local trig = hollowGetTrigger()
    if not trig then return false end
    if trig.CanTouch == false then return false end
    local portal = trig.Parent
    local active = portal and (portal:GetAttribute("Active") or portal:GetAttribute("Enabled") or portal:GetAttribute("Open"))
    if active == false then return false end
    return true
end

hollowArmTriggerTouch = function()
    for _, c in ipairs(hollowTouchedConns) do pcall(function() c:Disconnect() end) end
    hollowTouchedConns = {}
    S.hollowTouchedTrigger = false

    local function armFor(part, label)
        if not part then return end
        local conn = part.Touched:Connect(function(hit)
            if S.hollowTouchedTrigger then return end
            if not S.hollowAutoOn then return end
            local car = getCar()
            if not car then return end
            if hit and hit:IsDescendantOf(car) then
                S.hollowTouchedTrigger = true
                addLog("Portal " .. label .. " touched by car", "HOLLOW")
            end
        end)
        table.insert(hollowTouchedConns, conn)
    end

    armFor(hollowGetTrigger(), "Trigger")
    armFor(hollowGetPane(), "Pane")
end

hollowDisarmTriggerTouch = function()
    for _, c in ipairs(hollowTouchedConns) do pcall(function() c:Disconnect() end) end
    hollowTouchedConns = {}
    S.hollowTouchedTrigger = false
end

hollowFireEnterRemote = function()
    pcall(function()
        local pkgs = RS:FindFirstChild("Packages")
        local packets = pkgs and pkgs:FindFirstChild("Packets")
        local packet = packets and packets:FindFirstChild("Packet")
        local remote = packet and packet:FindFirstChild("RemoteEvent")
        if not remote or not remote:IsA("RemoteEvent") then return end
        local buf = buffer.fromstring(string.char(16))
        remote:FireServer(buf)
        addLog("HollowRuns: fired enter-dungeon remote (opcode 16)", "HOLLOW")
    end)
end

local lastSeatLog = 0
local function hollowEnsureSeated()
    local car = getCar()
    if not car then return end

    local char = lp and lp.Character
    local hum  = char and char:FindFirstChildOfClass("Humanoid")
    if not hum then return end

    local sp = hum.SeatPart
    if sp and sp:IsDescendantOf(car) then return end

    if tick() - S.hollowLastSeatTry < 0.15 then return end
    S.hollowLastSeatTry = tick()

    local seat = car:FindFirstChild("DriverSeat")
    if not (seat and (seat:IsA("VehicleSeat") or seat:IsA("Seat"))) then
        seat = nil
        for _, d in ipairs(car:GetDescendants()) do
            if (d:IsA("VehicleSeat") or d:IsA("Seat"))
               and string.find(string.lower(d.Name), "driver") then
                seat = d; break
            end
        end
    end
    if not seat then
        for _, d in ipairs(car:GetDescendants()) do
            if d:IsA("VehicleSeat") or d:IsA("Seat") then seat = d; break end
        end
    end
    if not seat then return end

    local hrp = char:FindFirstChild("HumanoidRootPart")
    if hrp then
        hrp.CFrame = seat.CFrame * CFrame.new(0, 0.5, 0)
        hrp.AssemblyLinearVelocity  = Vector3.zero
        hrp.AssemblyAngularVelocity = Vector3.zero
    end
    pcall(function() seat:Sit(hum) end)
    pcall(function() hum.Sit = true end)

    if tick() - lastSeatLog > 3 then
        lastSeatLog = tick()
        addLog("Auto-seat: attempted on " .. seat.Name, "HOLLOW")
    end
end

local function hollowDriveStep(pp, carPos, targetPos, speed)
    local flat = Vector3.new(targetPos.X - carPos.X, 0, targetPos.Z - carPos.Z)
    local dist = flat.Magnitude
    if dist < 0.05 then
        pp.AssemblyLinearVelocity = Vector3.new(0, pp.AssemblyLinearVelocity.Y, 0)
        return dist
    end
    local dir = flat / dist
    pp.AssemblyAngularVelocity = Vector3.zero
    pp.CFrame = CFrame.lookAt(
        Vector3.new(carPos.X, carPos.Y, carPos.Z),
        Vector3.new(carPos.X, carPos.Y, carPos.Z) + dir
    )
    local rp = RaycastParams.new()
    rp.FilterType = Enum.RaycastFilterType.Exclude
    local car = getCar()
    rp.FilterDescendantsInstances = lp and lp.Character and (car and {car, lp.Character} or {lp.Character}) or (car and {car} or {})
    local gRay = workspace:Raycast(carPos + Vector3.new(0, 30, 0), Vector3.new(0, -80, 0), rp)
    local targetY = gRay and (gRay.Position.Y + 3) or carPos.Y
    local yVel = math.clamp((targetY - carPos.Y) * 3, -40, 30)
    pp.AssemblyLinearVelocity = Vector3.new(dir.X * speed, yVel, dir.Z * speed)
    return dist
end

local function hollowBossIsAlive(m)
    if not m or not m.Parent then return false end
    local hum = m:FindFirstChildOfClass("Humanoid")
    if hum and hum.Health <= 0 then return false end
    local root = m:FindFirstChild("HumanoidRootPart") or m:FindFirstChild("Root") or m.PrimaryPart
    return root ~= nil
end

local function hollowBossRoot(m)
    if not m then return nil end
    return m:FindFirstChild("HumanoidRootPart") or m:FindFirstChild("Root") or m.PrimaryPart
end

