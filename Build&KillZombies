local _minDragActive = false
local _minDragMoved = false
local _minDragStart = Vector2.zero
local _minDragOrigin = Vector2.zero
local MIN_DRAG_THRESHOLD = 5

local function minBeginDrag(input)
    _minDragActive = true
    _minDragMoved = false
    _minDragStart = Vector2.new(input.Position.X, input.Position.Y)
    local abs = minWidget.AbsolutePosition
    minWidget.Position = UDim2.new(0, abs.X, 0, abs.Y)
    _minDragOrigin = Vector2.new(abs.X, abs.Y)
end

local function minUpdateDrag(input)
    if not _minDragActive then return end
    local cur = Vector2.new(input.Position.X, input.Position.Y)
    local delta = cur - _minDragStart
    if delta.Magnitude > MIN_DRAG_THRESHOLD then _minDragMoved = true end

    local vp = (workspace.CurrentCamera and workspace.CurrentCamera.ViewportSize) or Vector2.new(1920, 1080)
    local w = minWidget.AbsoluteSize.X
    local h = minWidget.AbsoluteSize.Y
    local newX = math.clamp(_minDragOrigin.X + delta.X, 0, math.max(0, vp.X - w))
    local newY = math.clamp(_minDragOrigin.Y + delta.Y, 0, math.max(0, vp.Y - h))
    minWidget.Position = UDim2.new(0, newX, 0, newY)
end

local function minEndDrag()
    if not _minDragActive then return end
    _minDragActive = false
    if not _minDragMoved then toggleMinimize() end
end

minWidgetClicker.InputBegan:Connect(function(input)
    local t = input.UserInputType
    if t == Enum.UserInputType.MouseButton1 or t == Enum.UserInputType.Touch then
