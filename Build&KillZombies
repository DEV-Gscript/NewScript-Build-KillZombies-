local function tweenToPlacement()
    task.spawn(function()
        pcall(function()
            local plot = myPlot()
            if not plot then return end
            local placement = plot:FindFirstChild("Placement")
            if not placement or not placement:IsA("BasePart") then return end
            local hrp = lp and lp.Character and lp.Character:FindFirstChild("HumanoidRootPart")
            if not hrp then return end

            local targetPos = (placement.CFrame * CFrame.new(0, 3, 15)).Position
            pcall(function()
                local rolls = plot:FindFirstChild("Rolls")
                if rolls then
                    local rPos = rolls.PrimaryPart and rolls.PrimaryPart.Position or rolls:GetPivot().Position
                    local dir = (Vector3.new(rPos.X, 0, rPos.Z) - Vector3.new(placement.Position.X, 0, placement.Position.Z)).Unit
                    targetPos = placement.Position + (dir * 13) + Vector3.new(0, 3, 0)
                end
            end)

            local FACE_ANGLE = -270
            local targetCFrame = CFrame.new(targetPos) * CFrame.Angles(0, math.rad(FACE_ANGLE), 0)
            local dist = (hrp.Position - targetCFrame.Position).Magnitude
            if dist > 3 then
                local tweenTime = math.clamp(dist / 30, 0.2, 1.2)
