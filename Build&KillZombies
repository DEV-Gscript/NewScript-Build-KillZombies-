local function findHackerFarmTargetCFrame()
    if S.hackerFarmSavedCF then
        local c = S.hackerFarmSavedCF
        local pos  = Vector3.new(c.px, c.py, c.pz)
        local look = Vector3.new(c.lx, c.ly, c.lz)
        if look.Magnitude > 0.01 then
            return CFrame.lookAt(pos, pos + look.Unit)
        end
        return CFrame.new(pos)
    end

    local g = workspace:FindFirstChild("Game")
    local stages = g and g:FindFirstChild("Stages")
    if not stages then return nil end
    local stage23 = stages:FindFirstChild("Stage_23")
    if not stage23 then return nil end
    local geo = stage23:FindFirstChild("Geometry")
    if not geo then return nil end
    local batch = geo:FindFirstChild("Batch_57")
    if not batch then return nil end
    local part = batch:FindFirstChild("Part")
    if part and part:IsA("BasePart") then
        return CFrame.new(part.Position + Vector3.new(0, 3, 0))
    end
    for _, d in ipairs(batch:GetDescendants()) do
        if d.Name == "Part" and d:IsA("BasePart") then
            return CFrame.new(d.Position + Vector3.new(0, 3, 0))
        end
    end
    return nil
end

