                    pp.AssemblyLinearVelocity = Vector3.new(0, pp.AssemblyLinearVelocity.Y, 0)
                    pp.AssemblyAngularVelocity = Vector3.zero
                    if dist > 0.5 then
                        pp.CFrame = CFrame.lookAt(
                            Vector3.new(carPos.X, carPos.Y, carPos.Z),
                            Vector3.new(bossPos.X, carPos.Y, bossPos.Z)
                        )
                    end
                    return
                end

                local ORBIT_ANG_SPEED = 2.5
                local RADIAL_K = 1.2
                local RADIAL_CLAMP_FRAC = 0.35

                S.hollowOrbitAngle = S.hollowOrbitAngle + ORBIT_ANG_SPEED * dt

                local toCar = Vector3.new(carPos.X - bossPos.X, 0, carPos.Z - bossPos.Z)
                local curRadius = toCar.Magnitude
                local radialUnit = curRadius > 0.01 and (toCar / curRadius) or Vector3.new(1, 0, 0)

                local carAngle = math.atan2(radialUnit.Z, radialUnit.X)
                local tangent = Vector3.new(-math.sin(carAngle), 0, math.cos(carAngle))

                local radialError = orbitRadius - curRadius
                local radialMag = math.clamp(
                    radialError * RADIAL_K,
                    -S.hollowOrbitSpeed * RADIAL_CLAMP_FRAC,
                    S.hollowOrbitSpeed * RADIAL_CLAMP_FRAC
                )
                local radialCorrect = radialUnit * radialMag

                local vx = tangent.X * S.hollowOrbitSpeed + radialCorrect.X
                local vz = tangent.Z * S.hollowOrbitSpeed + radialCorrect.Z

                pp.AssemblyLinearVelocity = Vector3.new(vx, pp.AssemblyLinearVelocity.y, vz)
                pp.AssemblyAngularVelocity = Vector3.zero

                local velXZ = Vector3.new(vx, 0, vz)
                if velXZ.Magnitude > 0.5 then
                    local lookDir = velXZ.Unit
                    pp.CFrame = CFrame.new(pp.Position, pp.Position + lookDir)
                end
                return
            end

            if z and hollowIsGateOpen(z) then
                local nz = hollowGetNextZone(z)
                local targetPos = nil
                if nz then
                    local sp = nz:FindFirstChild("CarSpawn")
                    if sp and sp:IsA("BasePart") then targetPos = sp.Position end
