local function fetchServers()
    local ok, result = pcall(function()
        return HttpService:JSONDecode(game:HttpGet(
            "https://games.roblox.com/v1/games/" .. game.PlaceId .. "/servers/Public?sortOrder=Asc&limit=100"
        ))
    end)
    if not ok or type(result) ~= "table" then return {} end
    return result.data or {}
end

local function pickServer()
    local servers = fetchServers()
    if #servers == 0 then return nil end
    local candidates = {}
    for _, srv in ipairs(servers) do
        local id = srv.id
        local playing = srv.playing or 0
        local maxP = srv.maxPlayers or 50
        if id and id ~= game.JobId then
            if S.hopperUseLowPop then
                if playing >= S.hopperMinPlayers and playing <= S.hopperMaxPlayers and playing < maxP then
                    table.insert(candidates, {id = id, playing = playing})
                end
            else
                if playing >= S.hopperMinPlayers and playing < maxP then
                    table.insert(candidates, {id = id, playing = playing})
                end
            end
        end
    end
    if #candidates == 0 then
        for _, srv in ipairs(servers) do
            local id = srv.id
            if id and id ~= game.JobId and (srv.playing or 0) < (srv.maxPlayers or 50) then
                table.insert(candidates, {id = id, playing = srv.playing or 0})
            end
        end
    end
    if #candidates == 0 then return nil end
    table.sort(candidates, function(a, b) return a.playing < b.playing end)
    local pickMax = math.min(#candidates, 5)
    return candidates[math.random(1, pickMax)]
end

local function hopServer()
    if S.hopping then
        notify("Hop already in progress...", true)
        return
    end
    S.hopping = true
    notify("Fetching server list...", false)

    local chosen = pickServer()
    if not chosen then
        S.hopping = false
        notify("No joinable servers found", true)
        addLog("Hopper: no servers returned", "HOPPER")
        return
    end

    addLog("Hopper: joining server " .. chosen.id .. " (" .. chosen.playing .. " players)", "HOPPER")
    notify("Hopping to server (" .. chosen.playing .. " players)", false)

    task.wait(0.6)
    local ok, err = pcall(function()
        TeleportService:TeleportToPlaceInstance(game.PlaceId, chosen.id, lp)
    end)
    if not ok then
        addLog("Hopper teleport failed: " .. tostring(err), "HOPPER")
        notify("Teleport failed: " .. tostring(err), true)
        S.hopping = false
    end
end

