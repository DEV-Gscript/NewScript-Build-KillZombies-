    S.blacklistText = blacklistInput.Text or ""
end)

blacklistApplyBtn.MouseButton1Click:Connect(function()
    S.blacklistText = blacklistInput.Text or ""
    refreshManualBlacklist()
    requestConfigSave()
    notify("Blacklist saved: " .. blacklistStatus.Text:gsub("Blacklist: ", ""), false)
end)

