local PartCatalogRef = nil

local function loadPartCatalog()
    if PartCatalogRef ~= nil then return PartCatalogRef end
    pcall(function()
        local node = RS
        for _, seg in ipairs({"Shared", "Data", "PartCatalog"}) do
            node = node and node:FindFirstChild(seg)
            if not node then return end
        end
        if not node then return end
        local ok, catalog = pcall(require, node)
        if ok and type(catalog) == "table" then
            PartCatalogRef = catalog
        end
    end)
    return PartCatalogRef
end

-- Extract a display stat from an entry's Stats table. Priority:
-- Damage > DPS > HP > Boost > Speed. Returns formatted string or nil.
local function getDisplayStat(stats)
    if type(stats) ~= "table" then return nil end
    local priority = {
        {"Damage", "DMG"},
        {"Dmg", "DMG"},
        {"ProjectileDamage", "DMG"},
        {"DPS", "DPS"},
        {"HP", "HP"},
        {"Health", "HP"},
        {"Boost", "BOOST"},
        {"FuelBoost", "FUEL"},
        {"SpeedBoost", "SPD"},
        {"Speed", "SPD"},
        {"FireRate", "ROF"},
        {"Range", "RNG"},
    }
    for _, pair in ipairs(priority) do
        local k, label = pair[1], pair[2]
        if type(stats[k]) == "number" then
            return string.format("%s %s", label, tostring(stats[k]))
        end
    end
    return nil
end

local function preloadPartCatalog()
    local catalog = loadPartCatalog()
    if not catalog or type(catalog.Parts) ~= "table" then
        addLog("PartCatalog not available", "SCAN")
        return 0
    end

    local added = 0
    for key, data in pairs(catalog.Parts) do
        if type(data) == "table" then
            local display = data.Name or key
            local before = discoveredItems[string.lower(display)]
            registerItem(display, data.Rarity or "Unknown", {
                category = data.Category,
                chance = data.Chance,
                cost = data.Cost,
                stats = data.Stats,
                modelKey = key,
            })
            if not before then added = added + 1 end

            -- Also register by the model key so prompts that give "SmallTank"
            -- (no space) still match the display entry.
            if key ~= display then
                local keyEntry = string.lower(key)
                if not discoveredItems[keyEntry] then
                    discoveredItems[keyEntry] = discoveredItems[string.lower(display)]
                end
            end
        end
    end

    itemListDirty = true
    addLog(string.format("PartCatalog preloaded: %d new entries", added), "SCAN")
    return added
end

-- ===================== RUNTIME SCAN (BACKUP) =====================
local ITEM_ROOT_HINTS = {"items", "rolls", "roll", "weapons", "blocks", "pool", "catalog", "rollable", "loot", "rewards"}

local function looksLikeItemRoot(name)
    local l = string.lower(name)
    for _, hint in ipairs(ITEM_ROOT_HINTS) do
        if string.find(l, hint, 1, true) then return true end
    end
    return false
end

local function scanContainer(node, depth, inItemRoot)
    if depth > 5 or not node then return end
    local ok, children = pcall(function() return node:GetChildren() end)
    if not ok or not children then return end

    for _, child in ipairs(children) do
        local cname = child.Name
        local rarity = nil
        pcall(function()
            rarity = child:GetAttribute("Rarity") or child:GetAttribute("ItemRarity") or child:GetAttribute("Tier")
        end)

        local isContainer = child:IsA("Folder") or child:IsA("Model")
            or child:IsA("Configuration") or child:IsA("ModuleScript")
            or child:IsA("StringValue") or child:IsA("ObjectValue")

        if inItemRoot and isContainer then
            registerItem(cname, rarity and tostring(rarity) or nil)
        end

        if rarity and not inItemRoot then
            registerItem(cname, tostring(rarity))
        end

        local nowInRoot = inItemRoot or looksLikeItemRoot(cname)
        if child:IsA("Folder") or child:IsA("Model") or child:IsA("Configuration") then
            scanContainer(child, depth + 1, nowInRoot)
        end
    end
end

local function scanForItems()
    local before = 0
    for _ in pairs(discoveredItems) do before = before + 1 end

    pcall(function() scanContainer(RS, 0, false) end)

    pcall(function()
        local g = workspace:FindFirstChild("Game")
        local plots = g and g:FindFirstChild("Lobby") and g.Lobby:FindFirstChild("Plots")
        if plots then
            for _, plot in ipairs(plots:GetChildren()) do
                local rolls = plot:FindFirstChild("Rolls")
                if rolls then
                    for _, rf in ipairs(rolls:GetChildren()) do
                        local ip = rf:FindFirstChild("ItemPlace")
                        if ip then
                            for _, item in ipairs(ip:GetChildren()) do
                                local r = item:GetAttribute("Rarity") or item:GetAttribute("ItemRarity")
                                registerItem(item.Name, r and tostring(r) or nil)
                            end
                        end
                    end
                end
            end
        end
    end)

    local after = 0
    for _ in pairs(discoveredItems) do after = after + 1 end
    return after - before, after
end

-- Normalizing lookup. Buy prompts give display names ("Small Tank").
-- Catalog has both key ("SmallTank") and display. Match by lowercasing
-- and stripping spaces.
local function findDiscovered(name)
    if not name or name == "" or name == "???" then return nil end
    local raw = tostring(name)
    local low = string.lower(raw)
    local flat = string.lower((string.gsub(raw, "%s+", "")))
    return discoveredItems[low] or discoveredItems[flat]
end

