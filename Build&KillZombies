            if bossRoot then
                local bossPos = bossRoot.Position
                local flat = Vector3.new(bossPos.X - carPos.X, 0, bossPos.Z - carPos.Z)
                local dist = flat.Magnitude
                local orbitRadius = S.hollowOrbitRadius
                local approachRange = orbitRadius + 10

                if dist > approachRange then
                    local dir = flat.Unit
                    pp.AssemblyAngularVelocity = Vector3.zero
                    pp.CFrame = CFrame.lookAt(
                        Vector3.new(carPos.X, carPos.Y, carPos.Z),
                        Vector3.new(carPos.X, carPos.Y, carPos.Z) + dir
