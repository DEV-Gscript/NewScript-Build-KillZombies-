                        pp.AssemblyLinearVelocity = Vector3.new(0, pp.AssemblyLinearVelocity.Y, 0)
                        pp.AssemblyAngularVelocity = Vector3.zero
                    else
                        local dir = flat.Unit
                        pp.AssemblyAngularVelocity = Vector3.zero
                        pp.CFrame = CFrame.lookAt(
                            Vector3.new(carPos.X, carPos.Y, carPos.Z),
                            Vector3.new(carPos.X, carPos.Y, carPos.Z) + dir
                        )
                        pp.AssemblyLinearVelocity = Vector3.new(
                            dir.X * S.hollowDriveSpeed,
                            pp.AssemblyLinearVelocity.Y,
                            dir.Z * S.hollowDriveSpeed
                        )
                    end
                end
                return
            end

            if z then
                local b = z:FindFirstChild("Bounds")
                if b and b:IsA("BasePart") then
                    local flat = Vector3.new(b.Position.X - carPos.X, 0, b.Position.Z - carPos.Z)
                    local dist = flat.Magnitude
                    if dist > S.hollowHoldRadius then
                        local dir = flat.Unit
                        pp.AssemblyAngularVelocity = Vector3.zero
                        pp.CFrame = CFrame.lookAt(
                            Vector3.new(carPos.X, carPos.Y, carPos.Z),
                            Vector3.new(carPos.X, carPos.Y, carPos.Z) + dir
                        )
                        pp.AssemblyLinearVelocity = Vector3.new(
                            dir.X * 100,
                            pp.AssemblyLinearVelocity.Y,
                            dir.Z * 100
                        )
                    else
                        pp.AssemblyLinearVelocity = Vector3.new(0, pp.AssemblyLinearVelocity.Y, 0)
                        pp.AssemblyAngularVelocity = Vector3.zero
                    end
                end
            end
            return
        end
    end)
end))

